PORT=1689
GITLAB_URL=

# GitLab API Token（用於讀取 MR diff、發佈 MR 留言）
GITLAB_PRIVATE_TOKEN=

# Copilot / GitHub Token（二擇一即可；若已在 Copilot CLI 模式登入，則可留空）
COPILOT_API_KEY=
GITHUB_TOKEN=

# Copilot CLI 路徑（讓 SDK 用預設路徑（PATH 或內建機制）找 CLI）
COPILOT_CLI_PATH=

# GitLab Webhook Secret
WEBHOOK_SECRET=

# 手動觸發端點 /trigger 的保護 Token（留空表示不驗證，建議正式環境設定）
ADMIN_TOKEN=

# 並行審查檔案數（預設 3，可依機器效能調整）
REVIEW_CONCURRENCY=3

# Copilot 模型名稱（預設 gpt-5-mini，可依需求調整）
COPILOT_MODEL=gpt-5-mini